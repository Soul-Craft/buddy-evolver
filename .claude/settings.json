{
  "permissions": {
    "allow": ["Bash(*readlink ~/.local/bin/claude*)", "Bash(*import json*claude.json*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf $HOME *)",
      "Bash(rm -rf \"$HOME\")",
      "Bash(rm -rf \"$HOME\" *)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr ~/)",
      "Bash(rm -fr ~ *)",
      "Bash(rm -fr $HOME)",
      "Bash(rm -fr $HOME/)",
      "Bash(rm -fr $HOME *)",
      "Bash(rm -fr \"$HOME\")",
      "Bash(rm -fr \"$HOME\" *)",
      "Bash(rm -r -f ~)",
      "Bash(rm -r -f ~/)",
      "Bash(rm -r -f ~ *)",
      "Bash(rm -r -f $HOME)",
      "Bash(rm -r -f $HOME/)",
      "Bash(rm -r -f $HOME *)",
      "Bash(rm -r -f \"$HOME\")",
      "Bash(rm -r -f \"$HOME\" *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git reset *--hard*)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}
